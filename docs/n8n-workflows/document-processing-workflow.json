    {
      "parameters": {
        "jsCode": "// Handle processing errors\nconst error = $json.error || $execution.lastNodeExecuted?.error?.message || 'Unknown processing error';\nconst documentData = $('Parse Document Request').first()?.json || {};\n\n// Log the error\nconsole.error('Document Processing Error:', {\n  error,\n  documentId: documentData.documentId,\n  customerId: documentData.customerId,\n  filename: documentData.filename,\n  timestamp: new Date().toISOString()\n});\n\n// Prepare error data for database update\nreturn [{\n  json: {\n    documentId: documentData.documentId,\n    error: error,\n    status: 'failed',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "handle-error",
      "name": "Handle Processing Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 520]
