# ===========================================
# N8N RAG Chat Dashboard - Environment Variables
# ===========================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-domain.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORG_ID=your-openai-org-id

# N8N Configuration
N8N_WEBHOOK_BASE_URL=https://your-n8n-domain.com/webhook
N8N_API_KEY=your-n8n-api-key
N8N_BASE_URL=https://your-n8n-domain.com

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
NODE_ENV=development

# Authentication
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=http://localhost:3000

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@your-domain.com

# Database Direct Connection (Optional)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Redis Configuration (Optional - for sessions and caching)
REDIS_URL=redis://localhost:6379

# Monitoring & Analytics
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Security
ENCRYPTION_KEY=your-32-character-encryption-key
JWT_SECRET=your-jwt-secret-key

# Feature Flags
ENABLE_VOICE_INPUT=true
ENABLE_FILE_UPLOAD=true
ENABLE_STREAMING=true
ENABLE_ANALYTICS=true

# Deployment
COOLIFY_APP_ID=your-coolify-app-id
DOCKER_REGISTRY=your-docker-registry

# Development
DEBUG=false
LOG_LEVEL=info

# Multi-language
DEFAULT_LANGUAGE=tr
SUPPORTED_LANGUAGES=tr,en

# Business Configuration
COMPANY_NAME=OSİDİEN
SUPPORT_EMAIL=support@osidien.com
ADMIN_EMAIL=admin@osidien.com