# Database Direct Connection (Optional)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Redis Configuration (Optional - for sessions and caching)
REDIS_URL=redis://localhost:6379

# Monitoring & Analytics
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Security
ENCRYPTION_KEY=your-32-character-encryption-key
JWT_SECRET=your-jwt-secret-key

# Feature Flags
ENABLE_VOICE_INPUT=true
ENABLE_FILE_UPLOAD=true
ENABLE_STREAMING=true
ENABLE_ANALYTICS=true

# Deployment
COOLIFY_APP_ID=your-coolify-app-id
DOCKER_REGISTRY=your-docker-registry

# Development
DEBUG=false
LOG_LEVEL=info

# Multi-language
DEFAULT_LANGUAGE=tr
SUPPORTED_LANGUAGES=tr,en

# Business Configuration - BotFusions Brand
