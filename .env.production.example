# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.production and fill with production values

# ============================================
# SUPABASE CONFIGURATION (Production)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-production-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-supabase-anon-key

# ============================================
# N8N WEBHOOK URLs (Production)
# ============================================
NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL=https://n8n.botfusions.com/webhook/4012a383-9085-4ecb-801a-c879848d6b40
NEXT_PUBLIC_N8N_EMBEDDING_WEBHOOK_URL=https://n8n.botfusions.com/webhook/embedding-upload

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=https://your-app.netlify.app
NEXT_PUBLIC_APP_NAME="TalksFusion"
NEXT_PUBLIC_API_URL=https://your-backend-api.com

# ============================================
# BACKEND API CONFIGURATION (Separate deployment)
# ============================================
# Backend should be deployed to: Railway, Render, Heroku, etc.
# BACKEND_URL=https://your-backend-api.com

# ============================================
# GOOGLE OAUTH (Production)
# ============================================
# Configure Google OAuth redirect URLs for production domain
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-production-google-client-id

# ============================================
# ANALYTICS & MONITORING (Optional)
# ============================================
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_VOICE_INPUT=true
NEXT_PUBLIC_ENABLE_FILE_UPLOAD=true

# ============================================
# BRANDING
# ============================================
NEXT_PUBLIC_BRAND_NAME=TalksFusion
NEXT_PUBLIC_SUPPORT_EMAIL=support@talksfusion.com
NEXT_PUBLIC_WEBSITE=https://talksfusion.com

# ============================================
# BUILD CONFIGURATION
# ============================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
