# ===========================================
# N8N RAG Chat - Docker Environment Variables
# Self-Hosted Supabase with Google OAuth
# ===========================================

# PostgreSQL Configuration
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-32-characters
JWT_EXPIRY=3600

# Supabase Configuration (Generated Keys)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEYyour-supabase-jwt-here
SUPABASE_SERVICE_ROLE_KEYyour-supabase-jwt-here

# Google OAuth Configuration
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id-from-console.apps.googleusercontent.com
GOTRUE_EXTERNAL_GOOGLE_SECRET=GOCSPX-your-google-client-secret-here
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/v1/callback

# Site URL ve Auth URLs (Docker Network + Production)
GOTRUE_SITE_URL=https://talksfusion.com
GOTRUE_URI_ALLOW_LIST=https://talksfusion.com,http://localhost:3000,http://localhost:8000
GOTRUE_EMAIL_CONFIRM_URL=https://talksfusion.com/auth/confirm
GOTRUE_PASSWORD_RESET_URL=https://talksfusion.com/auth/reset

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORG_ID=your-openai-org-id

# Email Configuration (SMTP) - Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cenk.tokgoz@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=cenk.tokgoz@gmail.com
SMTP_SECURE=false
SMTP_TLS=true

# N8N Configuration
N8N_WEBHOOK_BASE_URL=https://your-n8n-domain.com/webhook
N8N_API_KEYyour-supabase-jwt-here
N8N_BASE_URL=https://n8n.botfusions.com

# Application Configuration
NEXT_PUBLIC_APP_URL=https://talksfusion.com
BACKEND_URL=http://localhost:3001
NODE_ENV=development

# Authentication
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=https://talksfusion.com

# Security
ENCRYPTION_KEY=your-32-character-encryption-key